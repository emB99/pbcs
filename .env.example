NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required: first-run setup, team invites and role changes run server-side with this key.
# Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build redirect URLs for password reset, email confirmation, and
# Google sign-in. Set to the real deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend). Without a key, development records messages as "dry run" and
# sends nothing; production refuses to send. EMAIL_FROM must be an address on a
# domain you have verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Shared secret for the daily reminder job (/api/cron/reminders). Vercel sends it
# as a Bearer token when it is set as an environment variable. Needs the service-role key above.
CRON_SECRET=
